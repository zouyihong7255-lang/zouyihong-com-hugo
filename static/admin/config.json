{
  "backend": {
    "name": "github",
    "repo": "zouyihong7255-lang/zouyihong-com-hugo",
    "branch": "main",
    "base_url": "https://oauth.zouyihong.com",
    "auth_endpoint": "auth",
    "open_authoring": false,
    "commit_messages": {
      "create": "Create {{collection}} \"{{slug}}\"",
      "update": "Update {{collection}} \"{{slug}}\"",
      "delete": "Delete {{collection}} \"{{slug}}\"",
      "uploadMedia": "Upload \"{{path}}\"",
      "deleteMedia": "Delete \"{{path}}\"",
      "openAuthoring": false
    }
  },
  "media_folder": "static/uploads",
  "public_folder": "/uploads",
  "publish_mode": "editorial_workflow",
  "site_url": "https://zouyihong.com",
  "display_url": "https://zouyihong.com",
  "logo_url": "/favicon.ico",
  "locale": "zh-cn",
  "collections": [
    {
      "name": "pages",
      "label": "页面 (Pages)",
      "label_singular": "页面",
      "folder": "content",
      "create": true,
      "slug": "{{slug}}",
      "extension": "md",
      "format": "yaml-frontmatter",
      "summary": "{{title}} — {{date | date('YYYY-MM-DD')}}",
      "sortable_fields": [
        "title",
        "date"
      ],
      "fields": [
        {
          "label": "标题",
          "name": "title",
          "widget": "string"
        },
        {
          "label": "发布日期",
          "name": "date",
          "widget": "datetime",
          "format": "YYYY-MM-DD",
          "picker_utc": false
        },
        {
          "label": "草稿",
          "name": "draft",
          "widget": "boolean",
          "default": false,
          "required": false
        },
        {
          "label": "摘要",
          "name": "description",
          "widget": "text",
          "required": false
        },
        {
          "label": "正文 (Markdown)",
          "name": "body",
          "widget": "markdown"
        }
      ],
      "type": "content"
    },
    {
      "name": "posts",
      "label": "文章 (Posts)",
      "label_singular": "文章",
      "folder": "content/posts",
      "create": true,
      "slug": "{{year}}-{{month}}-{{day}}-{{slug}}",
      "extension": "md",
      "format": "yaml-frontmatter",
      "summary": "{{title}} — {{date | date('YYYY-MM-DD')}}",
      "sortable_fields": [
        "title",
        "date"
      ],
      "fields": [
        {
          "label": "标题",
          "name": "title",
          "widget": "string"
        },
        {
          "label": "发布日期",
          "name": "date",
          "widget": "datetime",
          "format": "YYYY-MM-DDTHH:mm:ssZ",
          "picker_utc": false
        },
        {
          "label": "草稿",
          "name": "draft",
          "widget": "boolean",
          "default": false,
          "required": false
        },
        {
          "label": "作者",
          "name": "author",
          "widget": "string",
          "default": "邹宜洪",
          "required": false
        },
        {
          "label": "标签",
          "name": "tags",
          "widget": "list",
          "required": false,
          "default": [
            "日常"
          ]
        },
        {
          "label": "分类",
          "name": "categories",
          "widget": "list",
          "required": false
        },
        {
          "label": "封面图 URL",
          "name": "cover",
          "widget": "image",
          "required": false,
          "allow_multiple": false
        },
        {
          "label": "摘要",
          "name": "description",
          "widget": "text",
          "required": false
        },
        {
          "label": "正文 (Markdown)",
          "name": "body",
          "widget": "markdown"
        }
      ],
      "type": "content"
    },
    {
      "name": "config",
      "label": "站点配置 (Config)",
      "label_singular": "配置",
      "files": [
        {
          "name": "hugo.yaml",
          "label": "Hugo 主配置",
          "file": "hugo.yaml",
          "format": "yaml",
          "fields": [
            {
              "label": "站点标题",
              "name": "title",
              "widget": "string"
            },
            {
              "label": "站点副标题",
              "name": "description",
              "widget": "text"
            },
            {
              "label": "作者",
              "name": "params.profileMode.author",
              "widget": "string"
            },
            {
              "label": "作者副标题",
              "name": "params.profileMode.subtitle",
              "widget": "text"
            },
            {
              "label": "GitHub",
              "name": "params.socialIcons.github",
              "widget": "string",
              "required": false
            },
            {
              "label": "邮箱",
              "name": "params.socialIcons.email",
              "widget": "string",
              "required": false
            },
            {
              "label": "主菜单",
              "name": "menu.main",
              "widget": "list",
              "field": {
                "label": "菜单项",
                "name": "item",
                "widget": "object",
                "fields": [
                  {
                    "label": "名称",
                    "name": "name",
                    "widget": "string"
                  },
                  {
                    "label": "URL",
                    "name": "url",
                    "widget": "string"
                  },
                  {
                    "label": "权重",
                    "name": "weight",
                    "widget": "number",
                    "default": 1
                  }
                ]
              }
            }
          ]
        }
      ],
      "type": "files"
    }
  ]
}

{
  "backend": {
    "name": "github",
    "repo": "zouyihong7255-lang/zouyihong-com-hugo",
    "branch": "main",
    "commit_branch": "main",
    "base_url": "https://oauth.zouyihong.com",
    "auth_endpoint": "auth",
    "open_authoring": false,
    "commit_messages": {
      "create": "Create {{collection}} \"{{slug}}\"",
      "update": "Update {{collection}} \"{{slug}}\"",
      "delete": "Delete {{collection}} \"{{slug}}\"",
      "uploadMedia": "Upload \"{{path}}\"",
      "deleteMedia": "Delete \"{{path}}\""
    }
  },
  "locale": "zh_Hans",
  "collections": [
    {
      "name": "pages",
      "label": "页面 (Pages)",
      "label_singular": "页面",
      "folder": "content",
      "create": true,
      "slug": "{{slug}}",
      "extension": "md",
      "format": "yaml-frontmatter",
      "summary": "{{title}} — {{date | date('YYYY-MM-DD')}}",
      "sortable_fields": [
        {
          "field": "title"
        },
        {
          "field": "date"
        }
      ],
      "view_filters": [],
      "view_groups": [],
      "fields": [
        {
          "label": "标题",
          "name": "title",
          "widget": "string"
        },
        {
          "label": "发布日期",
          "name": "date",
          "widget": "datetime",
          "format": "YYYY-MM-DD",
          "picker_utc": false,
          "required": false
        },
        {
          "label": "草稿",
          "name": "draft",
          "widget": "boolean",
          "required": false
        },
        {
          "label": "摘要",
          "name": "description",
          "widget": "text",
          "required": false
        },
        {
          "label": "正文 (Markdown)",
          "name": "body",
          "widget": "markdown"
        }
      ],
      "type": "folder_based_collection"
    },
    {
      "name": "posts",
      "label": "文章 (Posts)",
      "label_singular": "文章",
      "folder": "content/posts",
      "create": true,
      "slug": "{{year}}-{{month}}-{{day}}-{{slug}}",
      "extension": "md",
      "format": "yaml-frontmatter",
      "summary": "{{title}} — {{date | date('YYYY-MM-DD')}}",
      "sortable_fields": [
        {
          "field": "title"
        },
        {
          "field": "date"
        }
      ],
      "view_filters": [],
      "view_groups": [],
      "fields": [
        {
          "label": "标题",
          "name": "title",
          "widget": "string"
        },
        {
          "label": "发布日期",
          "name": "date",
          "widget": "datetime",
          "format": "YYYY-MM-DDTHH:mm:ssZ",
          "picker_utc": false
        },
        {
          "label": "草稿",
          "name": "draft",
          "widget": "boolean",
          "required": false
        },
        {
          "label": "作者",
          "name": "author",
          "widget": "string",
          "required": false
        },
        {
          "label": "标签",
          "name": "tags",
          "widget": "list",
          "required": false
        },
        {
          "label": "分类",
          "name": "categories",
          "widget": "list",
          "required": false
        },
        {
          "label": "摘要",
          "name": "description",
          "widget": "text",
          "required": false
        },
        {
          "label": "正文 (Markdown)",
          "name": "body",
          "widget": "markdown"
        }
      ],
      "type": "folder_based_collection"
    },
    {
      "name": "config",
      "label": "站点配置 (Config)",
      "label_singular": "配置",
      "type": "file_based_collection",
      "view_filters": [],
      "view_groups": [],
      "sortable_fields": [],
      "files": [
        {
          "name": "hugo",
          "label": "Hugo 主配置 (仅 title)",
          "file": "hugo.yaml",
          "format": "yaml",
          "fields": [
            {
              "label": "站点标题 (title)",
              "name": "title",
              "widget": "string"
            },
            {
              "label": "站点副标题 (siteDescription)",
              "name": "siteDescription",
              "widget": "text"
            },
            {
              "label": "作者 (siteAuthor)",
              "name": "siteAuthor",
              "widget": "string"
            },
            {
              "label": "作者副标题 (siteAuthorDescription)",
              "name": "siteAuthorDescription",
              "widget": "text"
            },
            {
              "label": "社交图标 (siteSocialIcons)",
              "name": "siteSocialIcons",
              "widget": "list",
              "field": {
                "label": "图标",
                "name": "icon",
                "widget": "object",
                "fields": [
                  {
                    "label": "图标名 (name)",
                    "name": "name",
                    "widget": "select",
                    "options": [
                      "email",
                      "github",
                      "linkedin",
                      "twitter",
                      "rss"
                    ]
                  },
                  {
                    "label": "标题 (title)",
                    "name": "title",
                    "widget": "string"
                  },
                  {
                    "label": "URL",
                    "name": "url",
                    "widget": "string"
                  }
                ]
              }
            },
            {
              "label": "顶部菜单 (siteMenu)",
              "name": "siteMenu",
              "widget": "list",
              "field": {
                "label": "菜单项",
                "name": "item",
                "widget": "object",
                "fields": [
                  {
                    "label": "标识符 (identifier)",
                    "name": "identifier",
                    "widget": "string"
                  },
                  {
                    "label": "名称 (name)",
                    "name": "name",
                    "widget": "string"
                  },
                  {
                    "label": "URL",
                    "name": "url",
                    "widget": "string"
                  },
                  {
                    "label": "权重 (weight)",
                    "name": "weight",
                    "widget": "number",
                    "default": 1
                  }
                ]
              }
            },
            {
              "label": "📋 高级：手动维护 params/menu 镜像段",
              "name": "_advanced_notice",
              "widget": "object",
              "collapsed": true,
              "fields": [
                {
                  "label": "说明",
                  "name": "notice",
                  "widget": "markdown",
                  "default": "**重要**:\n\n`siteAuthor` / `siteDescription` / `siteSocialIcons` / `siteMenu` 是**顶层字段**（**Decap 友好**）\n\n但 PaperMod theme 实际读 `params.author` / `params.description` / `params.socialIcons` / `menu.main`\n\n这两个段当前是**手动镜像**的（**通过 SSH + Jade 改**）\n\n如果 Decap 改了顶层**忘了镜像 params 段** —— **网站会变**！\n\n需要 Jade 写个 mirror 脚本（**deploy.sh 加一行**）"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "media_folder": "static/uploads",
  "public_folder": "/uploads"
}
